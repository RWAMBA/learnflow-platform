# ---- Supabase (client-visible) ----
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# ---- Supabase (server-only) ----
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Transactional email (invitations, verification reminders) ----
RESEND_API_KEY=
RESEND_FROM_EMAIL=LearnFlow <updates@example.com>

# ---- Observability ----
SENTRY_DSN=
VITE_SENTRY_DSN=

# ---- Application ----
VITE_APP_URL=http://localhost:8080

# ---- Public website abuse controls (server-only except the site key) ----
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TRUSTED_CLIENT_IP_HEADER=cf-connecting-ip
PUBLIC_IP_HASH_SALT=
PUBLIC_FINGERPRINT_SALT=
NEWSLETTER_TOKEN_SALT=

# Upload scanning adapter. The endpoint must accept raw bytes with a Bearer
# credential and return JSON { "clean": true } only for a clean document.
MALWARE_SCANNER_PROVIDER=http-json-v1
MALWARE_SCANNER_URL=https://scanner.example.com/v1/scan
MALWARE_SCANNER_API_KEY=
